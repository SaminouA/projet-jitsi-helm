{
  "__inputs": [
    {
      "name": "DS_MANAGED_PROMETHEUS",
      "label": "Managed Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "jitsi-gke-monitoring",
  "title": "Jitsi sur GKE",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU des nœuds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(kubernetes_io:node_cpu_core_usage_time{cluster_name=\"jitsi-cluster\"}[5m])",
          "legendFormat": "{{node_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Mémoire des nœuds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node_name) (kubernetes_io:node_memory_used_bytes{cluster_name=\"jitsi-cluster\"})",
          "legendFormat": "{{node_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "title": "CPU des pods Jitsi",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod_name) (rate(kubernetes_io:container_cpu_core_usage_time{cluster_name=\"jitsi-cluster\",namespace_name=\"jitsi\"}[5m]))",
          "legendFormat": "{{pod_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "title": "Mémoire des pods Jitsi",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod_name) (kubernetes_io:container_memory_used_bytes{cluster_name=\"jitsi-cluster\",namespace_name=\"jitsi\"})",
          "legendFormat": "{{pod_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "title": "Débit réseau des pods Jitsi",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "8 * sum(rate(kubernetes_io:pod_network_received_bytes_count{cluster_name=\"jitsi-cluster\",namespace_name=\"jitsi\",interface=\"eth0\"}[5m]))",
          "legendFormat": "Reçu",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "8 * sum(rate(kubernetes_io:pod_network_sent_bytes_count{cluster_name=\"jitsi-cluster\",namespace_name=\"jitsi\",interface=\"eth0\"}[5m]))",
          "legendFormat": "Émis",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      }
    },
    {
      "title": "Disponibilité des conteneurs Jitsi (Ready)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (pod) (kube_pod_container_status_ready{cluster=\"jitsi-cluster\",namespace=\"jitsi\"})",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "title": "Redémarrages des conteneurs Jitsi",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod_name) (kubernetes_io:container_restart_count{cluster_name=\"jitsi-cluster\",namespace_name=\"jitsi\"})",
          "legendFormat": "{{pod_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "title": "JVB · conférences",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jitsi_jvb_conferences{cluster=\"jitsi-cluster\",namespace=\"jitsi\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "id": 9,
      "title": "JVB · endpoints",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jitsi_jvb_current_endpoints{cluster=\"jitsi-cluster\",namespace=\"jitsi\"}",
          "legendFormat": "Courants",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "jitsi_jvb_active_endpoints{cluster=\"jitsi-cluster\",namespace=\"jitsi\"}",
          "legendFormat": "Actifs",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        },
        {
          "refId": "C",
          "expr": "jitsi_jvb_endpoints_sending_video{cluster=\"jitsi-cluster\",namespace=\"jitsi\"}",
          "legendFormat": "Émettent de la vidéo",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Endpoints du bridge et endpoints émettant de la vidéo. Ces métriques ne comptent pas tous les utilisateurs de la plateforme."
    },
    {
      "id": 10,
      "title": "JVB · débit RTP/RTCP",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jitsi_jvb_incoming_bitrate{cluster=\"jitsi-cluster\",namespace=\"jitsi\"}",
          "legendFormat": "Entrant",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "jitsi_jvb_outgoing_bitrate{cluster=\"jitsi-cluster\",namespace=\"jitsi\"}",
          "legendFormat": "Sortant",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "description": "Débit total RTP/RTCP du bridge. Inclut les différents médias et ne représente pas une mesure vidéo seule."
    },
    {
      "id": 11,
      "title": "JVB · taux de paquets",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jitsi_jvb_incoming_packet_rate{cluster=\"jitsi-cluster\",namespace=\"jitsi\"}",
          "legendFormat": "Entrant",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "jitsi_jvb_outgoing_packet_rate{cluster=\"jitsi-cluster\",namespace=\"jitsi\"}",
          "legendFormat": "Sortant",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "JVB · stress",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jitsi_jvb_stress{cluster=\"jitsi-cluster\",namespace=\"jitsi\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "title": "JVB · santé",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jitsi_jvb_healthy{cluster=\"jitsi-cluster\",namespace=\"jitsi\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      }
    },
    {
      "id": 14,
      "title": "Collecte JVB",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MANAGED_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{cluster=\"jitsi-cluster\",namespace=\"jitsi\",job=\"jitsi-jvb\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MANAGED_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
