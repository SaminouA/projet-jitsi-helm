
#!/bin/sh

# Se placer à la racine du projet
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "Verification Helm avant le commit..."

if ! helm lint ./charts-officiels/jitsi-meet -f mes-valeurs.yaml; then
    echo "ERREUR : commit bloque."
    exit 1
fi

echo "Verification reussie. Commit autorise."
exit 0
