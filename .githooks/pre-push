
#!/bin/sh

# Se placer à la racine du projet Git
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "Verification du Chart Helm avant le push..."

# Verifier la configuration Helm
if ! helm lint ./charts-officiels/jitsi-meet -f mes-valeurs.yaml; then
    echo "ERREUR : validation Helm echouee. Push annule."
    exit 1
fi

echo "Validation Helm reussie. Push autorise."
exit 0
